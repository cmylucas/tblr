# Google OAuth credentials — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: port for the OAuth redirect callback (default 8401)
GOOGLE_REDIRECT_PORT=8401

# Dedalus Labs AI (optional — for budget intelligence features)
# Get your API key from https://www.dedaluslabs.ai/
DEDALUS_API_KEY=your-dedalus-api-key
# Preferred model (default: anthropic/claude-sonnet-4.5)
DEDALUS_MODEL=anthropic/claude-sonnet-4.5
